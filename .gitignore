/bin/

# Runtime state — never commit. These are produced on the operator's host under
# $DEVMON_STATE_DIR and contain device records and private key material.
*.db
*.db-wal
*.db-shm
*.key
*.crt

coverage.out
.env

# Review write-ups are ephemeral working notes. Reviews are delivered in the
# session or as PR comments, never committed.
.claude/PRPs/reviews/
